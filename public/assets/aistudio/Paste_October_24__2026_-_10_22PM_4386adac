<!DOCTYPE html>
<html lang="id" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Material & Production Management System</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 h-full flex flex-col justify-between overflow-hidden select-none">

    <!-- Top Header Bar -->
    <header class="bg-slate-900 border-b border-slate-800 px-4 py-3 flex items-center justify-between z-20 shrink-0">
        <div class="flex items-center space-x-3">
            <button onclick="toggleSidebar(true)" class="p-2 rounded-xl bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition">
                <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
            <div>
                <h1 class="font-bold text-sm text-white tracking-wide">PRODTRACK <span id="adminBadge" class="hidden ml-1.5 px-1.5 py-0.5 bg-amber-500/20 text-amber-400 text-[10px] font-semibold rounded border border-amber-500/30">ADMIN</span></h1>
                <p class="text-[11px] text-slate-400" id="currentViewTitle">Dashboard Stock</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="openStorageTankModal()" class="flex items-center space-x-1.5 px-3 py-1.5 bg-slate-800 border border-slate-700 rounded-xl text-xs font-medium text-slate-200 hover:bg-slate-700 transition">
                <i data-lucide="droplet" class="w-3.5 h-3.5 text-cyan-400"></i>
                <span id="headerTankTemp">48.5°C</span>
            </button>
            <button onclick="openAdminModal()" id="headerAuthBtn" class="p-2 rounded-xl bg-slate-800 text-slate-300 hover:bg-slate-700 transition">
                <i data-lucide="shield" class="w-5 h-5"></i>
            </button>
        </div>
    </header>

    <!-- Main Container (Scrollable Area) -->
    <main id="mainContainer" class="flex-1 overflow-y-auto p-4 pb-24 relative">
        <!-- Dynamic Views Injected Here -->
    </main>

    <!-- Bottom Navigation Bar -->
    <nav class="bg-slate-900/95 backdrop-blur border-t border-slate-800 px-2 py-2 flex items-center justify-around z-20 shrink-0">
        <button onclick="switchTab('dashboard')" id="nav-dashboard" class="flex flex-col items-center justify-center w-16 py-1 text-cyan-400 transition">
            <i data-lucide="layout-dashboard" class="w-5 h-5 mb-1"></i>
            <span class="text-[10px] font-medium">Dashboard</span>
        </button>
        <button onclick="switchTab('permintaan')" id="nav-permintaan" class="flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-slate-200 transition">
            <i data-lucide="file-text" class="w-5 h-5 mb-1"></i>
            <span class="text-[10px] font-medium">Permintaan</span>
        </button>
        <button onclick="switchTab('penerimaan')" id="nav-penerimaan" class="flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-slate-200 transition">
            <i data-lucide="truck" class="w-5 h-5 mb-1"></i>
            <span class="text-[10px] font-medium">Penerimaan</span>
        </button>
        <button onclick="switchTab('pemakaian')" id="nav-pemakaian" class="flex flex-col items-center justify-center w-16 py-1 text-slate-400 hover:text-slate-200 transition">
            <i data-lucide="cpu" class="w-5 h-5 mb-1"></i>
            <span class="text-[10px] font-medium">Pemakaian</span>
        </button>
    </nav>

    <!-- Sidebar Drawer -->
    <div id="sidebarOverlay" onclick="toggleSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity opacity-0"></div>
    <aside id="sidebarDrawer" class="fixed top-0 bottom-0 left-0 w-80 bg-slate-900 border-r border-slate-800 z-50 transform -translate-x-full transition-transform duration-300 flex flex-col justify-between shadow-2xl">
        <div>
            <!-- Sidebar Header -->
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
                        <i data-lucide="package-open" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h2 class="font-bold text-sm text-white">ProdTrack System</h2>
                        <p class="text-xs text-slate-400" id="sidebarRoleText">Mode: Operator / Viewer</p>
                    </div>
                </div>
                <button onclick="toggleSidebar(false)" class="p-1.5 text-slate-400 hover:text-white rounded-lg bg-slate-800">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Sidebar Links -->
            <div class="p-4 space-y-2">
                <button onclick="switchTab('dashboard'); toggleSidebar(false);" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition">
                    <i data-lucide="layout-dashboard" class="w-4 h-4 text-cyan-400"></i>
                    <span>Dashboard Stock</span>
                </button>
                <button onclick="switchTab('permintaan'); toggleSidebar(false);" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition">
                    <i data-lucide="file-text" class="w-4 h-4 text-amber-400"></i>
                    <span>Permintaan Material</span>
                </button>
                <button onclick="switchTab('penerimaan'); toggleSidebar(false);" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition">
                    <i data-lucide="truck" class="w-4 h-4 text-emerald-400"></i>
                    <span>Penerimaan Material</span>
                </button>
                <button onclick="switchTab('pemakaian'); toggleSidebar(false);" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition">
                    <i data-lucide="cpu" class="w-4 h-4 text-purple-400"></i>
                    <span>Pemakaian Material</span>
                </button>

                <div class="pt-3 pb-1 border-t border-slate-800">
                    <p class="px-3 text-[10px] font-semibold tracking-wider text-slate-500 uppercase">Administrator Menu</p>
                </div>

                <button onclick="checkAdminAccess(() => { switchTab('master'); toggleSidebar(false); });" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-300 hover:bg-slate-800 hover:text-white transition">
                    <i data-lucide="database" class="w-4 h-4 text-rose-400"></i>
                    <span>Master Data & BOM Hierarki</span>
                </button>

                <button onclick="checkAdminAccess(() => { openResetModal(); toggleSidebar(false); });" class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-rose-400 hover:bg-rose-500/10 transition">
                    <i data-lucide="refresh-cw" class="w-4 h-4 text-rose-500"></i>
                    <span>Reset Semua Data</span>
                </button>
            </div>
        </div>

        <!-- Sidebar Footer -->
        <div class="p-4 border-t border-slate-800">
            <div id="sidebarAuthSection">
                <button onclick="openAdminModal()" class="w-full py-2.5 px-4 bg-cyan-600 hover:bg-cyan-500 text-white font-medium rounded-xl text-xs flex items-center justify-center space-x-2 transition shadow-lg shadow-cyan-600/20">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    <span>Login Administrator</span>
                </button>
            </div>
        </div>
    </aside>

    <!-- Modal Container -->
    <div id="appModal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div id="modalContent" class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-5 shadow-2xl relative">
            <!-- Dynamic Modal -->
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed top-16 left-1/2 -translate-x-1/2 z-50 transform -translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div id="toastMessage" class="bg-slate-900 border border-slate-700 text-white px-4 py-3 rounded-xl shadow-2xl text-xs font-medium flex items-center space-x-2">
            <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
            <span id="toastText">Berhasil memperbarui data</span>
        </div>
    </div>

    <!-- Application JavaScript -->
    <script>
        let appState = {
            isAdmin: false,
            currentTab: 'dashboard',
            master: {
                materials: [], // { id, name, type, source, packaging, weightKg }
                wips: [],      // { id, name, batchWeightKg }
                skus: [],      // { id, name, isKite, targetHour, cartonWeightKg }
                skuWips: [],   // { id, skuId, wipId, kgWipPerCartonSku }
                wipMats: []    // { id, wipId, materialId, materialKgPerBatch }
            },
            transactions: {
                requests: [],   // { id, date, skuId, wipId, materialId, qty, batch, saldoAwal, supplier }
                receipts: [],   // { id, date, requestId, materialId, requestedQty, receivedQty, location, status }
                usages: []      // { id, date, skuId, wipId, materialId, qty, batch, usageQty }
            },
            tank: {
                level: 750.0,
                temp: 48.5
            }
        };

        function saveState() {
            localStorage.setItem('prodtrack_state_v6', JSON.stringify(appState));
        }

        function loadState() {
            const saved = localStorage.getItem('prodtrack_state_v6');
            if (saved) {
                try {
                    appState = JSON.parse(saved);
                } catch (e) {
                    console.error("Failed to parse saved state", e);
                }
            }
        }

        window.onload = function() {
            loadState();
            lucide.createIcons();
            renderView();
            setInterval(simulateTankTemp, 5000);
        };

        function simulateTankTemp() {
            let delta = (Math.random() - 0.5) * 0.8;
            appState.tank.temp = Math.min(55, Math.max(45, appState.tank.temp + delta));
            const tankEl = document.getElementById('headerTankTemp');
            if (tankEl) tankEl.innerText = appState.tank.temp.toFixed(1) + '°C';
            saveState();
        }

        function switchTab(tabId) {
            appState.currentTab = tabId;
            document.querySelectorAll('nav button').forEach(btn => {
                btn.classList.remove('text-cyan-400');
                btn.classList.add('text-slate-400');
            });
            const activeBtn = document.getElementById('nav-' + tabId);
            if (activeBtn) {
                activeBtn.classList.remove('text-slate-400');
                activeBtn.classList.add('text-cyan-400');
            }
            renderView();
        }

        function toggleSidebar(open) {
            const drawer = document.getElementById('sidebarDrawer');
            const overlay = document.getElementById('sidebarOverlay');
            if (open) {
                drawer.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                drawer.classList.add('-translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function showToast(msg, isError = false) {
            const toast = document.getElementById('toast');
            const toastText = document.getElementById('toastText');
            toastText.innerText = msg;
            toast.classList.remove('pointer-events-none', '-translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        function openAdminModal() {
            if (appState.isAdmin) {
                appState.isAdmin = false;
                saveState();
                updateAdminUI();
                showToast("Berhasil keluar dari mode Administrator");
                renderView();
                return;
            }

            const modal = document.getElementById('appModal');
            const content = document.getElementById('modalContent');
            content.innerHTML = `
                <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="shield-check" class="w-5 h-5 text-amber-400"></i>
                        <h3 class="font-bold text-sm text-white">Autentikasi Administrator</h3>
                    </div>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
                </div>
                <form onsubmit="handleAdminLogin(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-300 mb-1">PIN Administrator</label>
                        <input type="password" id="adminPinInput" required placeholder="Masukkan PIN" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-cyan-500">
                    </div>
                    <div class="pt-2">
                        <button type="submit" class="w-full py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-xs font-semibold shadow-lg shadow-cyan-600/20 transition">Masuk sebagai Admin</button>
                    </div>
                </form>
            `;
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function handleAdminLogin(e) {
            e.preventDefault();
            const pin = document.getElementById('adminPinInput').value;
            if (pin === '12345678') {
                appState.isAdmin = true;
                saveState();
                closeModal();
                updateAdminUI();
                showToast("Akses Administrator Diizinkan");
                renderView();
            } else {
                showToast("PIN Administrator Salah", true);
            }
        }

        function checkAdminAccess(callback) {
            if (appState.isAdmin) {
                callback();
            } else {
                openAdminModal();
            }
        }

        function updateAdminUI() {
            const badge = document.getElementById('adminBadge');
            const headerAuthBtn = document.getElementById('headerAuthBtn');
            const sidebarRole = document.getElementById('sidebarRoleText');
            const authSection = document.getElementById('sidebarAuthSection');

            if (appState.isAdmin) {
                badge.classList.remove('hidden');
                headerAuthBtn.innerHTML = `<i data-lucide="unlock" class="w-5 h-5 text-amber-400"></i>`;
                sidebarRole.innerText = "Mode: Administrator Aktif";
                authSection.innerHTML = `<button onclick="openAdminModal()" class="w-full py-2.5 px-4 bg-rose-600/20 border border-rose-500/30 hover:bg-rose-600/30 text-rose-400 font-medium rounded-xl text-xs flex items-center justify-center space-x-2 transition">
                    <i data-lucide="log-out" class="w-4 h-4"></i>
                    <span>Keluar Admin</span>
                </button>`;
            } else {
                badge.classList.add('hidden');
                headerAuthBtn.innerHTML = `<i data-lucide="shield" class="w-5 h-5"></i>`;
                sidebarRole.innerText = "Mode: Operator / Viewer";
                authSection.innerHTML = `<button onclick="openAdminModal()" class="w-full py-2.5 px-4 bg-cyan-600 hover:bg-cyan-500 text-white font-medium rounded-xl text-xs flex items-center justify-center space-x-2 transition shadow-lg shadow-cyan-600/20">
                    <i data-lucide="lock" class="w-4 h-4"></i>
                    <span>Login Administrator</span>
                </button>`;
            }
            lucide.createIcons();
        }

        function closeModal() {
            document.getElementById('appModal').classList.add('hidden');
        }

        function renderView() {
            updateAdminUI();
            const container = document.getElementById('mainContainer');
            const titleEl = document.getElementById('currentViewTitle');

            if (appState.currentTab === 'dashboard') {
                titleEl.innerText = "Dashboard Stock & Storage";
                container.innerHTML = renderDashboardView();
            } else if (appState.currentTab === 'permintaan') {
                titleEl.innerText = "Permintaan Material";
                container.innerHTML = renderPermintaanView();
            } else if (appState.currentTab === 'penerimaan') {
                titleEl.innerText = "Penerimaan Material";
                container.innerHTML = renderPenerimaanView();
            } else if (appState.currentTab === 'pemakaian') {
                titleEl.innerText = "Pemakaian Material & WIP";
                container.innerHTML = renderPemakaianView();
            } else if (appState.currentTab === 'master') {
                titleEl.innerText = "Master Data & BOM Hierarki";
                container.innerHTML = renderMasterView();
            }
            lucide.createIcons();
        }

        // --- 1. DASHBOARD VIEW ---
        function renderDashboardView() {
            let stockMap = {};
            appState.master.materials.forEach(m => {
                stockMap[m.id] = { ck: 0, wineroto: 0, total: 0, name: m.name, type: m.type };
            });

            appState.transactions.receipts.forEach(r => {
                if (r.status === 'Received') {
                    if (stockMap[r.materialId]) {
                        if (r.location === 'CK') stockMap[r.materialId].ck += r.receivedQty;
                        if (r.location === 'WINEROTO') stockMap[r.materialId].wineroto += r.receivedQty;
                        stockMap[r.materialId].total += r.receivedQty;
                    }
                }
            });

            appState.transactions.usages.forEach(u => {
                if (stockMap[u.materialId]) {
                    let rem = u.usageQty;
                    if (stockMap[u.materialId].ck >= rem) {
                        stockMap[u.materialId].ck -= rem;
                    } else {
                        rem -= stockMap[u.materialId].ck;
                        stockMap[u.materialId].ck = 0;
                        stockMap[u.materialId].wineroto = Math.max(0, stockMap[u.materialId].wineroto - rem);
                    }
                    stockMap[u.materialId].total = stockMap[u.materialId].ck + stockMap[u.materialId].wineroto;
                }
            });

            let totalCk = 0, totalWineroto = 0;
            Object.values(stockMap).forEach(s => {
                totalCk += s.ck;
                totalWineroto += s.wineroto;
            });

            let materialRows = Object.values(stockMap).map(s => `
                <tr class="border-b border-slate-800/60 hover:bg-slate-900/40 text-xs">
                    <td class="py-3 px-3 font-medium text-white">${s.name} <span class="text-[10px] text-slate-400 block">${s.type}</span></td>
                    <td class="py-3 px-3 text-right text-slate-300">${s.ck.toFixed(4)} kg</td>
                    <td class="py-3 px-3 text-right text-slate-300">${s.wineroto.toFixed(4)} kg</td>
                    <td class="py-3 px-3 text-right font-bold text-cyan-400">${s.total.toFixed(4)} kg</td>
                </tr>
            `).join('');

            return `
                <div class="space-y-4 max-w-4xl mx-auto">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl relative overflow-hidden">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Area Penyimpanan CK</span>
                                <i data-lucide="warehouse" class="w-4 h-4 text-cyan-400"></i>
                            </div>
                            <div class="text-2xl font-bold text-white mb-1">${totalCk.toFixed(2)} <span class="text-xs font-normal text-slate-400">kg</span></div>
                            <p class="text-[11px] text-slate-400">Bubuk GDRM & Formulasi</p>
                        </div>
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl relative overflow-hidden">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Area WINEROTO</span>
                                <i data-lucide="building-2" class="w-4 h-4 text-emerald-400"></i>
                            </div>
                            <div class="text-2xl font-bold text-white mb-1">${totalWineroto.toFixed(2)} <span class="text-xs font-normal text-slate-400">kg</span></div>
                            <p class="text-[11px] text-slate-400">Liquid & Bubuk Campuran</p>
                        </div>
                        <div class="bg-gradient-to-br from-slate-900 to-cyan-950/30 border border-cyan-500/30 p-4 rounded-2xl relative overflow-hidden">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-xs font-semibold text-cyan-400 uppercase tracking-wider">Tank Liquid (1000 kg)</span>
                                <i data-lucide="thermometer" class="w-4 h-4 text-cyan-400"></i>
                            </div>
                            <div class="flex items-baseline justify-between">
                                <div class="text-2xl font-bold text-white">${appState.tank.level.toFixed(1)} <span class="text-xs font-normal text-slate-400">kg</span></div>
                                <div class="text-xs font-semibold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">${appState.tank.temp.toFixed(1)}°C (45-55°C)</div>
                            </div>
                            <div class="w-full bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                                <div class="bg-gradient-to-r from-cyan-500 to-emerald-400 h-full rounded-full" style="width: ${(appState.tank.level / 1000 * 100)}%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                        <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="boxes" class="w-4 h-4 text-cyan-400"></i>
                                <span>Rincian Stock Material Aktual (Auto-Saved Database)</span>
                            </h3>
                            <span class="text-xs text-slate-400">Total SKU: ${appState.master.skus.length} | WIP: ${appState.master.wips.length} | Material: ${appState.master.materials.length}</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-800/50 text-[11px] font-semibold text-slate-400 border-b border-slate-800">
                                        <th class="py-2.5 px-3">Nama Material</th>
                                        <th class="py-2.5 px-3 text-right">Stock CK</th>
                                        <th class="py-2.5 px-3 text-right">Stock Wineroto</th>
                                        <th class="py-2.5 px-3 text-right">Total Aktual</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${materialRows.length > 0 ? materialRows : `<tr><td colspan="4" class="text-center py-8 text-slate-500 text-xs">Aplikasi awal kosong. Belum ada material atau stock tercatat. Silakan input Master Data terlebih dahulu.</td></tr>`}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        // --- 2. PERMINTAAN VIEW ---
        function renderPermintaanView() {
            if (appState.master.wips.length === 0 || appState.master.skus.length === 0 || appState.master.skuWips.length === 0) {
                return `
                    <div class="max-w-md mx-auto text-center py-12 px-4 bg-slate-900 border border-slate-800 rounded-2xl mt-8">
                        <i data-lucide="alert-triangle" class="w-12 h-12 text-amber-400 mx-auto mb-3"></i>
                        <h3 class="font-bold text-base text-white mb-1">Master Data / BOM Belum Lengkap</h3>
                        <p class="text-xs text-slate-400 mb-4">Sebelum komponen penyusun WIP dan hierarki BOM ditetapkan administrator, permintaan material tidak dapat dilakukan.</p>

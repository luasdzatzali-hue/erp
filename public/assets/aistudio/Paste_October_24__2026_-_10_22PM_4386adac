            let wipOptions = appState.master.wips.map(w => `<option value="${w.id}">${w.name}</option>`).join('');
            let matOptions = appState.master.materials.map(m => `<option value="${m.id}">${m.name} (${m.source} - ${m.type} - ${m.weightKg.toFixed(4)} kg)</option>`).join('');

            let historyRows = appState.transactions.requests.map(req => {
                let sObj = appState.master.skus.find(s => s.id == req.skuId);
                let wObj = appState.master.wips.find(w => w.id == req.wipId);
                let mObj = appState.master.materials.find(m => m.id == req.materialId);
                return `
                    <tr class="border-b border-slate-800/60 hover:bg-slate-900/40 text-xs">
                        <td class="py-3 px-3 font-medium text-white">${sObj ? sObj.name : '-'} <span class="text-[10px] text-amber-400 block">${sObj && sObj.isKite ? 'Ekspor KITE' : 'Domestik'}</span></td>
                        <td class="py-3 px-3 text-slate-300">${wObj ? wObj.name : '-'}</td>
                        <td class="py-3 px-3 text-slate-300">${mObj ? mObj.name : '-'} <span class="text-[10px] text-cyan-400 block">${req.supplier}</span></td>
                        <td class="py-3 px-3 text-right font-bold text-cyan-400">${req.qty.toFixed(4)} kg / ${req.batch.toFixed(4)} batch</td>
                        <td class="py-3 px-3 text-right text-slate-400">${req.saldoAwal.toFixed(4)} kg</td>
                    </tr>
                `;
            }).join('');

            return `
                <div class="max-w-4xl mx-auto space-y-4">
                    <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                        <h3 class="font-bold text-sm text-white mb-3 flex items-center space-x-2">
                            <i data-lucide="file-plus" class="w-4 h-4 text-cyan-400"></i>
                            <span>Form Permintaan Material ke Supplier (GDRM / Formulasi)</span>
                        </h3>
                        <form onsubmit="handleCreateRequest(event)" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih SKU Produk</label>
                                <select id="reqSkuId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih SKU --</option>
                                    ${skuOptions}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Jenis WIP</label>
                                <select id="reqWipId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih WIP --</option>
                                    ${wipOptions}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Material Dibutuhkan (Database Acuan)</label>
                                <select id="reqMatId" onchange="autofillRequestQty()" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih Material --</option>
                                    ${matOptions}
                                </select>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Jumlah Batch WIP</label>
                                    <input type="number" step="0.0001" id="reqBatchCount" oninput="autofillRequestQty()" required placeholder="1.0000" value="1" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Supplier</label>
                                    <select id="reqSupplier" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                        <option value="GDRM">GDRM</option>
                                        <option value="Formulasi">Formulasi</option>
                                    </select>
                                </div>
                            </div>
                            <div class="sm:col-span-2">
                                <label class="block text-xs font-medium text-slate-300 mb-1">Qty Total (kg) - (Autofill Database x Jumlah Batch)</label>
                                <input type="number" step="0.0001" id="reqQty" required placeholder="0.0000" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white font-mono text-cyan-400">
                            </div>
                            <div class="sm:col-span-2 pt-2">
                                <button type="submit" class="w-full py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-cyan-600/20 transition flex items-center justify-center space-x-2">
                                    <i data-lucide="send" class="w-4 h-4"></i>
                                    <span>Kirim Permintaan Material</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                        <div class="p-4 border-b border-slate-800">
                            <h3 class="font-bold text-sm text-white">History Permintaan Material</h3>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-800/50 text-[11px] font-semibold text-slate-400 border-b border-slate-800">
                                        <th class="py-2.5 px-3">SKU</th>
                                        <th class="py-2.5 px-3">WIP</th>
                                        <th class="py-2.5 px-3">Nama Material</th>
                                        <th class="py-2.5 px-3 text-right">Qty/Batch</th>
                                        <th class="py-2.5 px-3 text-right">Saldo Awal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${historyRows.length > 0 ? historyRows : `<tr><td colspan="5" class="text-center py-8 text-slate-500 text-xs">Belum ada history permintaan material.</td></tr>`}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        function autofillRequestQty() {
            const matId = document.getElementById('reqMatId').value;
            const batchCount = parseFloat(document.getElementById('reqBatchCount').value) || 1;
            const mObj = appState.master.materials.find(m => m.id === matId);
            const qtyField = document.getElementById('reqQty');
            const supplierField = document.getElementById('reqSupplier');

            if (mObj && qtyField) {
                let totalReq = mObj.weightKg * batchCount;
                qtyField.value = totalReq.toFixed(4);
                if (supplierField && mObj.source) {
                    supplierField.value = mObj.source;
                }
            }
        }

        function handleCreateRequest(e) {
            e.preventDefault();
            const skuId = document.getElementById('reqSkuId').value;
            const wipId = document.getElementById('reqWipId').value;
            const materialId = document.getElementById('reqMatId').value;
            const qty = parseFloat(document.getElementById('reqQty').value) || 0;
            const batchCount = parseFloat(document.getElementById('reqBatchCount').value) || 1;
            const supplier = document.getElementById('reqSupplier').value;

            let saldoAwal = Math.random() * 500 + 100;

            const newReq = {
                id: Date.now(),
                date: new Date().toLocaleDateString('id-ID'),
                skuId,
                wipId,
                materialId,
                qty,
                batch: batchCount,
                saldoAwal,
                supplier
            };

            appState.transactions.requests.push(newReq);
            saveState();
            showToast("Permintaan material berhasil dikirim ke " + supplier);
            renderView();
        }

        // --- 3. PENERIMAAN VIEW ---
        function renderPenerimaanView() {
            let pendingRequests = appState.transactions.requests;

            let receiptRows = appState.transactions.receipts.map(rec => {
                let mObj = appState.master.materials.find(m => m.id == rec.materialId);
                return `
                    <tr class="border-b border-slate-800/60 hover:bg-slate-900/40 text-xs">
                        <td class="py-3 px-3 text-slate-300">${rec.date}</td>
                        <td class="py-3 px-3 font-medium text-white">${mObj ? mObj.name : 'Material'}</td>
                        <td class="py-3 px-3 text-right text-slate-300">${rec.requestedQty.toFixed(4)} kg</td>
                        <td class="py-3 px-3 text-right font-bold text-emerald-400">${rec.receivedQty.toFixed(4)} kg</td>
                        <td class="py-3 px-3 text-cyan-400">${rec.location}</td>
                        <td class="py-3 px-3 text-right"><span class="px-2 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded text-[10px]">${rec.status}</span></td>
                    </tr>
                `;
            }).join('');

            let requestOptionsForReceive = pendingRequests.map(req => {
                let mObj = appState.master.materials.find(m => m.id == req.materialId);
                return `<option value="${req.id}">${mObj ? mObj.name : 'Mat'} - Req: ${req.qty.toFixed(4)} kg (${req.supplier})</option>`;
            }).join('');

            return `
                <div class="max-w-4xl mx-auto space-y-4">
                    <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                        <h3 class="font-bold text-sm text-white mb-3 flex items-center space-x-2">
                            <i data-lucide="truck" class="w-4 h-4 text-emerald-400"></i>
                            <span>Pencatatan Kedatangan & Penerimaan Material (GDRM / Formulasi)</span>
                        </h3>
                        <form onsubmit="handleReceiveMaterial(event)" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Permintaan Material</label>
                                <select id="recReqId" onchange="populateReceiveQty(this.value)" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih Permintaan --</option>
                                    ${requestOptionsForReceive}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Lokasi Penyimpanan Tujuan</label>
                                <select id="recLocation" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="CK">Area CK</option>
                                    <option value="WINEROTO">Area WINEROTO</option>
                                    <option value="STORAGE_TANK">Tank Liquid (1000 kg)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Koreksi Kuantitas Diterima (kg)</label>
                                <input type="number" step="0.0001" id="recQty" required placeholder="Sesuai fisik kedatangan" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                            </div>
                            <div class="flex items-end">
                                <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-emerald-600/20 transition flex items-center justify-center space-x-2">
                                    <i data-lucide="check-circle" class="w-4 h-4"></i>
                                    <span>Terima & Simpan Material</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                        <div class="p-4 border-b border-slate-800">
                            <h3 class="font-bold text-sm text-white">History Penerimaan Material</h3>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-800/50 text-[11px] font-semibold text-slate-400 border-b border-slate-800">
                                        <th class="py-2.5 px-3">Tanggal</th>
                                        <th class="py-2.5 px-3">Material</th>
                                        <th class="py-2.5 px-3 text-right">Diminta</th>
                                        <th class="py-2.5 px-3 text-right">Diterima</th>
                                        <th class="py-2.5 px-3">Lokasi Simpan</th>
                                        <th class="py-2.5 px-3 text-right">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${receiptRows.length > 0 ? receiptRows : `<tr><td colspan="6" class="text-center py-8 text-slate-500 text-xs">Belum ada history penerimaan material.</td></tr>`}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        function populateReceiveQty(reqId) {
            const reqObj = appState.transactions.requests.find(r => r.id == reqId);
            const recQty = document.getElementById('recQty');
            if (reqObj && recQty) {
                recQty.value = reqObj.qty;
            }
        }

        function handleReceiveMaterial(e) {
            e.preventDefault();
            const reqId = document.getElementById('recReqId').value;
            const location = document.getElementById('recLocation').value;
            const receivedQty = parseFloat(document.getElementById('recQty').value) || 0;

            const reqObj = appState.transactions.requests.find(r => r.id == reqId);
            if (!reqObj) {
                showToast("Permintaan tidak ditemukan", true);
                return;
            }

            const newReceipt = {
                id: Date.now(),
                date: new Date().toLocaleDateString('id-ID'),
                requestId: reqId,
                materialId: reqObj.materialId,
                requestedQty: reqObj.qty,
                receivedQty,
                location,
                status: 'Received'
            };

            appState.transactions.receipts.push(newReceipt);
            if (location === 'STORAGE_TANK') {
                appState.tank.level = Math.min(1000, appState.tank.level + receivedQty);
            }
            saveState();
            showToast("Penerimaan material berhasil dicatat dan stok diperbarui");
            renderView();
        }

        // --- 4. PEMAKAIAN VIEW ---
        function renderPemakaianView() {
            let skuOptions = appState.master.skus.map(s => `<option value="${s.id}">${s.name} ${s.isKite ? '(KITE)' : '(Domestik)'}</option>`).join('');
            let wipOptions = appState.master.wips.map(w => `<option value="${w.id}">${w.name}</option>`).join('');
            let matOptions = appState.master.materials.map(m => `<option value="${m.id}">${m.name}</option>`).join('');

            let usageRows = appState.transactions.usages.map(u => {
                let sObj = appState.master.skus.find(s => s.id == u.skuId);
                let wObj = appState.master.wips.find(w => w.id == u.wipId);
                let mObj = appState.master.materials.find(m => m.id == u.materialId);
                return `
                    <tr class="border-b border-slate-800/60 hover:bg-slate-900/40 text-xs">
                        <td class="py-3 px-3 font-medium text-white">${sObj ? sObj.name : '-'}</td>
                        <td class="py-3 px-3 text-slate-300">${wObj ? wObj.name : '-'}</td>
                        <td class="py-3 px-3 text-slate-300">${mObj ? mObj.name : '-'}</td>
                        <td class="py-3 px-3 text-right text-slate-300">${u.qty.toFixed(4)} kg / ${u.batch.toFixed(4)} batch</td>
                        <td class="py-3 px-3 text-right font-bold text-rose-400">-${u.usageQty.toFixed(4)} kg</td>
                    </tr>
                `;
            }).join('');

            return `
                <div class="max-w-4xl mx-auto space-y-4">
                    <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
                        <h3 class="font-bold text-sm text-white mb-3 flex items-center space-x-2">
                            <i data-lucide="cpu" class="w-4 h-4 text-purple-400"></i>
                            <span>Input Rencana Pemakaian Material & WIP</span>
                        </h3>
                        <form onsubmit="handleUsageMaterial(event)" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih SKU Produk</label>
                                <select id="useSkuId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih SKU --</option>
                                    ${skuOptions}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih WIP Produksi</label>
                                <select id="useWipId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih WIP --</option>
                                    ${wipOptions}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Material Terpakai (Database)</label>
                                <select id="useMatId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="">-- Pilih Material --</option>
                                    ${matOptions}
                                </select>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Qty (kg)</label>
                                    <input type="number" step="0.0001" id="useQty" required placeholder="0.0000" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Total Pemakaian (kg)</label>
                                    <input type="number" step="0.0001" id="useUsageQty" required placeholder="0.0000" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                </div>
                            </div>
                            <div class="sm:col-span-2 pt-2">
                                <button type="submit" class="w-full py-2.5 bg-purple-600 hover:bg-purple-500 text-white font-semibold rounded-xl text-xs shadow-lg shadow-purple-600/20 transition flex items-center justify-center space-x-2">
                                    <i data-lucide="play-circle" class="w-4 h-4"></i>
                                    <span>Catat Pemakaian & Kurangi Stock Otomatis</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
                        <div class="p-4 border-b border-slate-800">
                            <h3 class="font-bold text-sm text-white">History Pemakaian Material</h3>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-800/50 text-[11px] font-semibold text-slate-400 border-b border-slate-800">
                                        <th class="py-2.5 px-3">SKU</th>
                                        <th class="py-2.5 px-3">WIP</th>
                                        <th class="py-2.5 px-3">Nama Material</th>
                                        <th class="py-2.5 px-3 text-right">Qty/Batch</th>
                                        <th class="py-2.5 px-3 text-right">Pemakaian</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${usageRows.length > 0 ? usageRows : `<tr><td colspan="5" class="text-center py-8 text-slate-500 text-xs">Belum ada history pemakaian material.</td></tr>`}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;
        }

        function handleUsageMaterial(e) {
            e.preventDefault();
            const skuId = document.getElementById('useSkuId').value;
            const wipId = document.getElementById('useWipId').value;
            const materialId = document.getElementById('useMatId').value;
            const qty = parseFloat(document.getElementById('useQty').value) || 0;
            const usageQty = parseFloat(document.getElementById('useUsageQty').value) || 0;

            const newUsage = {
                id: Date.now(),
                date: new Date().toLocaleDateString('id-ID'),
                skuId,
                wipId,
                materialId,
                qty,
                batch: qty / 25,
                usageQty
            };

            appState.transactions.usages.push(newUsage);
            let mObj = appState.master.materials.find(m => m.id == materialId);
            if (mObj && mObj.type.toLowerCase() === 'liquid') {
                appState.tank.level = Math.max(0, appState.tank.level - usageQty);
            }

            saveState();
            showToast("Pemakaian material berhasil dicatat dan stok dikurangi");
            renderView();
        }

        // --- 5. MASTER DATA & HIERARCHICAL BOM VIEW ---
        function renderMasterView() {
            if (!appState.isAdmin) {
                return `
                    <div class="max-w-md mx-auto text-center py-12 px-4 bg-slate-900 border border-slate-800 rounded-2xl mt-8">

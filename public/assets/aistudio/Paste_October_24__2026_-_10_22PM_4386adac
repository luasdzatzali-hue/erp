                    </div>
                </div>
            `).join('');

            let wipList = appState.master.wips.map(w => `
                <div class="bg-slate-800/50 border border-slate-700/60 p-3 rounded-xl flex items-center justify-between text-xs">
                    <div>
                        <span class="font-bold text-white">${w.name}</span>
                        <div class="text-[10px] text-slate-400">Berat Batch: ${w.batchWeightKg.toFixed(4)} kg</div>
                    </div>
                    <button onclick="deleteWip('${w.id}')" class="text-rose-400 hover:text-rose-300 text-[10px]">Hapus</button>
                </div>
            `).join('');

            let skuList = appState.master.skus.map(s => `
                <div class="bg-slate-800/50 border border-slate-700/60 p-3 rounded-xl flex items-center justify-between text-xs">
                    <div>
                        <span class="font-bold text-white">${s.name} <span class="text-[10px] px-1.5 py-0.2 ${s.isKite ? 'bg-amber-500/20 text-amber-400' : 'bg-cyan-500/20 text-cyan-400'} rounded">${s.isKite ? 'KITE (Ekspor)' : 'Domestik'}</span></span>
                        <div class="text-[10px] text-slate-400">Target: ${s.targetHour} karton/jam | Berat: ${s.cartonWeightKg.toFixed(4)} kg/karton</div>
                    </div>
                    <button onclick="deleteSku('${s.id}')" class="text-rose-400 hover:text-rose-300 text-[10px]">Hapus</button>
                </div>
            `).join('');

            let skuSelectOptions = appState.master.skus.map(s => `<option value="${s.id}">${s.name} ${s.isKite ? '(KITE)' : '(Domestik)'}</option>`).join('');
            let wipSelectOptions = appState.master.wips.map(w => `<option value="${w.id}">${w.name}</option>`).join('');
            let matSelectOptions = appState.master.materials.map(m => `<option value="${m.id}">${m.name} (${m.type} - ${m.weightKg.toFixed(4)} kg)</option>`).join('');

            // Hierarchical BOM visualization & configuration (Separated per WIP)
            let hierarchicalBOMHTML = appState.master.skus.map(sku => {
                let skuWipComps = appState.master.skuWips.filter(sw => sw.skuId === sku.id);
                let wipComponentsHTML = skuWipComps.map(sw => {
                    let wObj = appState.master.wips.find(w => w.id === sw.wipId);
                    let wipMatComps = appState.master.wipMats.filter(wm => wm.wipId === sw.wipId);
                    let materialBreakdownHTML = wipMatComps.map(wm => {
                        let mObj = appState.master.materials.find(m => m.id === wm.materialId);
                        return `
                            <div class="bg-slate-900 border border-slate-800 p-2.5 rounded-xl flex items-center justify-between text-xs ml-4 my-1.5">
                                <div class="flex items-center space-x-2">
                                    <i data-lucide="box" class="w-3 h-3 text-cyan-400"></i>
                                    <span class="text-slate-300">${mObj ? mObj.name : 'Material'} <span class="text-[10px] text-slate-400">(${mObj ? mObj.type : ''})</span></span>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <span class="font-mono text-cyan-400">${wm.materialKgPerBatch.toFixed(4)} kg / batch WIP</span>
                                    <button onclick="deleteWipMat('${wm.id}')" class="text-rose-400 hover:text-rose-300 text-[10px]">Hapus</button>
                                </div>
                            </div>
                        `;
                    }).join('');

                    return `
                        <div class="bg-slate-800/60 border border-slate-700 p-3 rounded-xl space-y-2 mb-2">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-2">
                                    <i data-lucide="layers" class="w-4 h-4 text-amber-400"></i>
                                    <span class="font-bold text-white text-xs">WIP Terpisah: ${wObj ? wObj.name : 'WIP'}</span>
                                </div>
                                <div class="flex items-center space-x-3">
                                    <span class="text-xs font-semibold text-amber-400">${sw.kgWipPerCartonSku.toFixed(4)} kg WIP / karton SKU</span>
                                    <button onclick="deleteSkuWip('${sw.id}')" class="text-rose-400 hover:text-rose-300 text-[10px]">Hapus</button>
                                </div>
                            </div>
                            <div class="pl-4 border-l-2 border-amber-500/30 space-y-1">
                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Kalkulasi 1 Batch WIP dari Database Material:</p>
                                ${materialBreakdownHTML.length > 0 ? materialBreakdownHTML : '<p class="text-[11px] text-slate-500 italic">Belum ada material yang diinput untuk batch WIP ini.</p>'}
                            </div>
                        </div>
                    `;
                }).join('');

                return `
                    <div class="bg-slate-800/30 border border-slate-700/70 p-4 rounded-xl space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-700/50 pb-2">
                            <div class="flex items-center space-x-2">
                                <i data-lucide="package" class="w-4 h-4 text-cyan-400"></i>
                                <h4 class="font-bold text-sm text-white">SKU: ${sku.name} <span class="text-xs px-1.5 py-0.5 ${sku.isKite ? 'bg-amber-500/20 text-amber-400' : 'bg-cyan-500/20 text-cyan-400'} rounded">${sku.isKite ? 'KITE (Ekspor)' : 'Domestik'}</span> <span class="text-xs font-normal text-slate-400">(${sku.cartonWeightKg.toFixed(4)} kg/karton, Target: ${sku.targetHour} karton/jam)</span></h4>
                            </div>
                            <span class="text-[10px] px-2 py-0.5 bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 rounded">Hierarki Utama</span>
                        </div>
                        <div class="space-y-2">
                            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Komponen WIP Terpisah (kg WIP / karton SKU):</p>
                            ${wipComponentsHTML.length > 0 ? wipComponentsHTML : '<p class="text-[11px] text-slate-500 italic py-1">Belum ada WIP terpisah yang diikat ke SKU ini.</p>'}
                        </div>
                    </div>
                `;
            }).join('');

            return `
                <div class="max-w-4xl mx-auto space-y-6 pb-8">
                    <!-- Notification Banner for Auto-Save Database -->
                    <div class="bg-cyan-950/40 border border-cyan-500/30 p-3 rounded-xl flex items-center justify-between text-xs text-cyan-300">
                        <div class="flex items-center space-x-2">
                            <i data-lucide="database" class="w-4 h-4 text-cyan-400 shrink-0"></i>
                            <span>Database Material Aktif (Autosave): Semua material yang diinput tersimpan otomatis & langsung menjadi acuan dropdown batch WIP dengan autofill berat kilogram (4 desimal).</span>
                        </div>
                        <span class="px-2 py-0.5 bg-cyan-500/20 text-cyan-300 font-semibold rounded text-[10px]">Auto-Saved</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <!-- Material Master Form -->
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="database" class="w-4 h-4 text-rose-400"></i>
                                <span>1. Input Material (Autosave DB)</span>
                            </h3>
                            <form onsubmit="handleAddMaterial(event)" class="space-y-2">
                                <input type="text" id="matName" required placeholder="Nama Material" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <select id="matType" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="liquid">Liquid</option>
                                    <option value="bubuk">Bubuk</option>
                                    <option value="padat">Padat</option>
                                </select>
                                <select id="matSource" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                    <option value="GDRM">GDRM (Kemasan 20/25/50kg)</option>
                                    <option value="Formulasi">Formulasi (Custom Batch)</option>
                                </select>
                                <input type="text" id="matPackaging" required placeholder="Kemasan (e.g. 25 kg atau Batching 6.447 kg)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <input type="number" step="0.0001" id="matWeight" required placeholder="Berat (Kilogram, 4 desimal)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <button type="submit" class="w-full py-2 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold">Simpan & Autosave Material</button>
                            </form>
                            <div class="space-y-2 max-h-48 overflow-y-auto no-scrollbar pt-2 border-t border-slate-800">
                                ${matList || '<p class="text-[11px] text-slate-500">Belum ada material.</p>'}
                            </div>
                        </div>

                        <!-- WIP Master Form -->
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="layers" class="w-4 h-4 text-amber-400"></i>
                                <span>2. Input WIP</span>
                            </h3>
                            <form onsubmit="handleAddWip(event)" class="space-y-2">
                                <input type="text" id="wipName" required placeholder="Nama WIP" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <input type="number" step="0.0001" id="wipBatchWeight" required placeholder="Berat 1 Batch WIP (kg, 4 desimal)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <button type="submit" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-semibold">Simpan WIP</button>
                            </form>
                            <div class="space-y-2 max-h-48 overflow-y-auto no-scrollbar pt-2 border-t border-slate-800">
                                ${wipList || '<p class="text-[11px] text-slate-500">Belum ada WIP.</p>'}
                            </div>
                        </div>

                        <!-- SKU Master Form -->
                        <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="box" class="w-4 h-4 text-cyan-400"></i>
                                <span>3. Input SKU (Domestik / KITE Ekspor)</span>
                            </h3>
                            <form onsubmit="handleAddSku(event)" class="space-y-2">
                                <input type="text" id="skuName" required placeholder="Nama SKU Produk" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <div class="flex items-center space-x-2 bg-slate-800 px-3 py-2 rounded-xl border border-slate-700">
                                    <input type="checkbox" id="skuIsKite" class="w-4 h-4 rounded text-cyan-600 bg-slate-700 border-slate-600">
                                    <label for="skuIsKite" class="text-xs text-slate-300 font-medium">Tandai sebagai SKU Ekspor (KITE)</label>
                                </div>
                                <input type="number" step="0.0001" id="skuTarget" required placeholder="Target SKU per Jam (karton)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <input type="number" step="0.0001" id="skuWeight" required placeholder="Berat SKU (Kilogram per karton)" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                <button type="submit" class="w-full py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-xs font-semibold">Simpan SKU</button>
                            </form>
                            <div class="space-y-2 max-h-48 overflow-y-auto no-scrollbar pt-2 border-t border-slate-800">
                                ${skuList || '<p class="text-[11px] text-slate-500">Belum ada SKU.</p>'}
                            </div>
                        </div>
                    </div>

                    <!-- Step 4: BOM Configuration (A. SKU to WIP kg/carton, B. WIP batch to Material kg with Autofill) -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- A. Tentukan WIP (kg/karton) untuk SKU -->
                        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-4">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="git-branch" class="w-4 h-4 text-cyan-400"></i>
                                <span>A. Tentukan Jenis WIP (kg/karton) untuk 1 Karton SKU</span>
                            </h3>
                            <form onsubmit="handleAddSkuWip(event)" class="space-y-3 bg-slate-800/40 p-3 rounded-xl border border-slate-700/50">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Pilih SKU Produk</label>
                                    <select id="swSkuId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                        <option value="">-- Pilih SKU --</option>
                                        ${skuSelectOptions}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Jenis WIP Terpisah</label>
                                    <select id="swWipId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                        <option value="">-- Pilih WIP --</option>
                                        ${wipSelectOptions}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Kebutuhan WIP (Kilogram / Karton SKU)</label>
                                    <input type="number" step="0.0001" id="swKgPerCarton" required placeholder="0.0000" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                </div>
                                <button type="submit" class="w-full py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white rounded-xl text-xs font-semibold">Tautkan WIP ke SKU</button>
                            </form>
                        </div>

                        <!-- B. Tentukan Batch WIP dari Database Material dengan Autofill -->
                        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-4">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="cpu" class="w-4 h-4 text-amber-400"></i>
                                <span>B. Tentukan Batch WIP dari Database Material (Autofill kg)</span>
                            </h3>
                            <form onsubmit="handleAddWipMat(event)" class="space-y-3 bg-slate-800/40 p-3 rounded-xl border border-slate-700/50">
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Target WIP</label>
                                    <select id="wmWipId" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                        <option value="">-- Pilih WIP --</option>
                                        ${wipSelectOptions}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Pilih Material dari Database (Autosave)</label>
                                    <select id="wmMatId" onchange="autofillMaterialWeight(this.value)" required class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white">
                                        <option value="">-- Pilih Material Database --</option>
                                        ${matSelectOptions}
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-medium text-slate-300 mb-1">Berat Material per Batch WIP (Kilogram - Autofilled)</label>
                                    <input type="number" step="0.0001" id="wmKgBatch" required placeholder="0.0000" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white font-mono text-cyan-400">
                                </div>
                                <button type="submit" class="w-full py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl text-xs font-semibold">Tautkan Material ke Batch WIP</button>
                            </form>
                        </div>
                    </div>

                    <!-- Professional Hierarchical BOM Tree Visualization (Separated per WIP) -->
                    <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                            <h3 class="font-bold text-sm text-white flex items-center space-x-2">
                                <i data-lucide="network" class="w-4 h-4 text-emerald-400"></i>
                                <span>Visualisasi BOM Hierarki Profesional (SKU &rarr; WIP Terpisah &rarr; Material Database)</span>
                            </h3>
                            <span class="text-xs text-slate-400">Industrial Standard 4-Decimal Precision</span>
                        </div>
                        <div class="space-y-4">
                            ${hierarchicalBOMHTML || '<div class="text-center py-8 text-slate-500 text-xs">Belum ada konfigurasi hierarki BOM terpisah. Silakan tambahkan SKU, WIP, dan Material terlebih dahulu.</div>'}
                        </div>
                    </div>
                </div>
            `;
        }

        function autofillMaterialWeight(materialId) {
            const mObj = appState.master.materials.find(m => m.id === materialId);
            const inputField = document.getElementById('wmKgBatch');
            if (mObj && inputField) {
                inputField.value = mObj.weightKg;
                showToast("Autofill berat material: " + mObj.weightKg + " kg");
            }
        }

        function handleAddMaterial(e) {
            e.preventDefault();
            const name = document.getElementById('matName').value;
            const type = document.getElementById('matType').value;
            const source = document.getElementById('matSource').value;
            const packaging = document.getElementById('matPackaging').value;
            const weightKg = parseFloat(document.getElementById('matWeight').value) || 0;

            appState.master.materials.push({
                id: 'mat_' + Date.now(),
                name, type, source, packaging, weightKg
            });
            saveState();
            showToast("Material berhasil di-autosave ke database");
            renderView();
        }

        function handleAddWip(e) {
            e.preventDefault();
            const name = document.getElementById('wipName').value;
            const batchWeightKg = parseFloat(document.getElementById('wipBatchWeight').value) || 0;

            appState.master.wips.push({
                id: 'wip_' + Date.now(),
                name, batchWeightKg
            });
            saveState();
            showToast("WIP berhasil ditambahkan");
            renderView();
        }

        function handleAddSku(e) {
            e.preventDefault();
            const name = document.getElementById('skuName').value;
            const isKite = document.getElementById('skuIsKite').checked;
            const targetHour = parseFloat(document.getElementById('skuTarget').value) || 0;
            const cartonWeightKg = parseFloat(document.getElementById('skuWeight').value) || 0;

            appState.master.skus.push({
                id: 'sku_' + Date.now(),
                name, isKite, targetHour, cartonWeightKg
            });
            saveState();
            showToast("SKU (" + (isKite ? 'KITE Ekspor' : 'Domestik') + ") berhasil ditambahkan");
            renderView();
        }

        function handleAddSkuWip(e) {
            e.preventDefault();
            const skuId = document.getElementById('swSkuId').value;
            const wipId = document.getElementById('swWipId').value;
            const kgWipPerCartonSku = parseFloat(document.getElementById('swKgPerCarton').value) || 0;

            appState.master.skuWips.push({
                id: 'sw_' + Date.now(),
                skuId,
                wipId,
                kgWipPerCartonSku
            });
            saveState();
            showToast("WIP terpisah berhasil diikat ke SKU (kg WIP/karton SKU)");
            renderView();
        }

        function handleAddWipMat(e) {
            e.preventDefault();
            const wipId = document.getElementById('wmWipId').value;
            const materialId = document.getElementById('wmMatId').value;
            const materialKgPerBatch = parseFloat(document.getElementById('wmKgBatch').value) || 0;

            appState.master.wipMats.push({
                id: 'wm_' + Date.now(),
                wipId,
                materialId,
                materialKgPerBatch
            });
            saveState();
            showToast("Material dari database berhasil ditautkan ke batch WIP dengan autofill");
            renderView();
        }

        function deleteMaterial(id) {
            appState.master.materials = appState.master.materials.filter(m => m.id !== id);
            appState.master.wipMats = appState.master.wipMats.filter(wm => wm.materialId !== id);
            saveState();
            showToast("Material dihapus");
            renderView();
        }

        function deleteWip(id) {
            appState.master.wips = appState.master.wips.filter(w => w.id !== id);
            appState.master.skuWips = appState.master.skuWips.filter(sw => sw.wipId !== id);
            appState.master.wipMats = appState.master.wipMats.filter(wm => wm.wipId !== id);
            saveState();
            showToast("WIP dihapus");
            renderView();
        }

        function deleteSku(id) {
            appState.master.skus = appState.master.skus.filter(s => s.id !== id);
            appState.master.skuWips = appState.master.skuWips.filter(sw => sw.skuId !== id);
            saveState();
            showToast("SKU dihapus");
            renderView();
        }

        function deleteSkuWip(id) {
            appState.master.skuWips = appState.master.skuWips.filter(sw => sw.id !== id);
            saveState();
            showToast("Relasi WIP terpisah ke SKU dihapus");
            renderView();
        }

        function deleteWipMat(id) {
            appState.master.wipMats = appState.master.wipMats.filter(wm => wm.id !== id);
            saveState();
            showToast("Relasi Material ke WIP dihapus");
            renderView();
        }

        function openResetModal() {
            const modal = document.getElementById('appModal');
            const content = document.getElementById('modalContent');
            content.innerHTML = `
                <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                    <div class="flex items-center space-x-2 text-rose-400">
                        <i data-lucide="alert-octagon" class="w-5 h-5"></i>
                        <h3 class="font-bold text-sm text-white">Reset Semua Data Sistem</h3>
                    </div>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
                </div>
                <p class="text-xs text-slate-300 mb-4">Tindakan ini akan menghapus seluruh data SKU, WIP, Material Autosave Database, BOM Hierarki, Permintaan, Penerimaan, Pemakaian, dan stock kembali kosong total.</p>
                <div class="flex space-x-3">
                    <button onclick="closeModal()" class="w-1/2 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-semibold">Batal</button>
                    <button onclick="executeFullReset()" class="w-1/2 py-2.5 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-semibold shadow-lg shadow-rose-600/20">Reset Sekarang</button>
                </div>
            `;
            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function executeFullReset() {
            appState = {
                isAdmin: false,
                currentTab: 'dashboard',
                master: { materials: [], wips: [], skus: [], skuWips: [], wipMats: [] },
                transactions: { requests: [], receipts: [], usages: [] },
                tank: { level: 1000.0, temp: 50.0 }
            };
            saveState();
            closeModal();
            showToast("Semua data berhasil di-reset bersih total");
            renderView();
        }

        function openStorageTankModal() {
            const modal = document.getElementById('appModal');
            const content = document.getElementById('modalContent');
            content.innerHTML = `
                <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                    <div class="flex items-center space-x-2 text-cyan-400">
                        <i data-lucide="droplet" class="w-5 h-5"></i>
                        <h3 class="font-bold text-sm text-white">Storage Tank Liquid (Kapasitas 1000 kg)</h3>
                    </div>
                    <button onclick="closeModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
                </div>
                <div class="space-y-4 text-xs">
                    <div class="bg-slate-800 p-3 rounded-xl flex justify-between items-center">
                        <span class="text-slate-300">Level Liquid Aktual:</span>
                        <span class="font-bold text-cyan-400 text-sm">${appState.tank.level.toFixed(2)} kg / 1000 kg</span>
                    </div>
                    <div class="bg-slate-800 p-3 rounded-xl flex justify-between items-center">
                        <span class="text-slate-300">Suhu Storage Tank:</span>
                        <span class="font-bold text-amber-400 text-sm">${appState.tank.temp.toFixed(1)}°C (Target: 45-55°C)</span>
                    </div>
                    <p class="text-[11px] text-slate-400">Pengurangan WIP liquid disesuaikan otomatis dengan jumlah material liquid yang terpakai.</p>
                    <button onclick="closeModal()" class="w-full py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-xl font-semibold">Tutup</button>
                </div>
            `;
            modal.classList.remove('hidden');
            lucide.createIcons();
        }
    </script>
</body>
</html>
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function userEmailLower() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    function isBootstrappedEmailAdmin() {
      return isVerified() && userEmailLower() == 'luasdzatzali@gmail.com';
    }

    function accessConfigPath(workspaceId) {
      return /databases/$(database)/documents/workspaces/$(workspaceId)/config/access;
    }

    function hasAccessConfig(workspaceId) {
      return exists(accessConfigPath(workspaceId));
    }

    function accessData(workspaceId) {
      return get(accessConfigPath(workspaceId)).data;
    }

    // Strict Multi-Tenant Workspace Admin Check (Isolated per workspaceId)
    function isWorkspaceAdmin(workspaceId) {
      return isVerified() && (
        workspaceId == request.auth.uid ||
        (workspaceId == 'main' && isBootstrappedEmailAdmin()) ||
        (
          hasAccessConfig(workspaceId) && (
            accessData(workspaceId).ownerUid == request.auth.uid ||
            userEmailLower() in accessData(workspaceId).adminEmails
          )
        )
      );
    }

    function isWorkspaceOperator(workspaceId) {
      return isVerified() &&
        hasAccessConfig(workspaceId) &&
        userEmailLower() in accessData(workspaceId).operatorEmails;
    }

    function isWorkspaceManagement(workspaceId) {
      return isVerified() &&
        hasAccessConfig(workspaceId) &&
        userEmailLower() in accessData(workspaceId).managementEmails;
    }

    function isWorkspaceAuthorized(workspaceId) {
      return isWorkspaceAdmin(workspaceId) ||
        isWorkspaceOperator(workspaceId) ||
        isWorkspaceManagement(workspaceId);
    }

    // 3. Entity Validation Blueprints
    function isValidSystemBootstrap(data) {
      return data.keys().hasAll(['isInitialized', 'ownerUid', 'factoryName', 'initializedAt', 'updatedAt']) &&
        data.keys().hasOnly(['isInitialized', 'ownerUid', 'factoryName', 'initializedAt', 'updatedAt']) &&
        data.isInitialized is bool &&
        data.isInitialized == true &&
        isValidId(data.ownerUid) &&
        data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 120 &&
        data.initializedAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'factoryName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'factoryName', 'workspaceId', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 120 &&
        (!('workspaceId' in data) || (isValidId(data.workspaceId) && data.workspaceId.size() <= 64)) &&
        data.role in ['SUPER_ADMIN', 'ADMIN'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWorkspaceDirectoryEntry(data) {
      return data.keys().hasAll(['inviteId', 'emailLower', 'workspaceId', 'role', 'factoryName', 'ownerUid', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly(['inviteId', 'emailLower', 'workspaceId', 'role', 'factoryName', 'ownerUid', 'updatedAt', 'updatedByUid']) &&
        isValidId(data.inviteId) && data.inviteId.size() >= 64 && data.inviteId.size() <= 128 &&
        data.emailLower is string && data.emailLower.size() >= 3 && data.emailLower.size() <= 160 &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        data.role in ['ADMINISTRATOR', 'OPERATOR', 'MANAGEMENT'] &&
        data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 120 &&
        isValidId(data.ownerUid) &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidWorkspaceAccessConfig(data) {
      return data.keys().hasAll(['workspaceId', 'ownerUid', 'adminEmails', 'operatorEmails', 'managementEmails', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly(['workspaceId', 'ownerUid', 'adminEmails', 'operatorEmails', 'managementEmails', 'updatedAt', 'updatedByUid']) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.adminEmails is list && data.adminEmails.size() <= 30 && (data.adminEmails.size() == 0 || data.adminEmails[0] is string) &&
        data.operatorEmails is list && data.operatorEmails.size() <= 100 && (data.operatorEmails.size() == 0 || data.operatorEmails[0] is string) &&
        data.managementEmails is list && data.managementEmails.size() <= 50 && (data.managementEmails.size() == 0 || data.managementEmails[0] is string) &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidWorkspaceSecrets(data) {
      return data.keys().hasAll(['workspaceId', 'ownerUid', 'adminPin', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly(['workspaceId', 'ownerUid', 'adminPin', 'updatedAt', 'updatedByUid']) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.adminPin is string && data.adminPin.size() >= 4 && data.adminPin.size() <= 256 &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidWorkspaceMeta(data) {
      return data.keys().hasAll(['workspaceId', 'ownerUid', 'factoryName', 'adminGoogleEmails', 'registeredOperators', 'registeredManagement', 'theme', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly(['workspaceId', 'ownerUid', 'factoryName', 'adminGoogleEmails', 'registeredOperators', 'registeredManagement', 'theme', 'updatedAt', 'updatedByUid']) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.factoryName is string && data.factoryName.size() >= 1 && data.factoryName.size() <= 120 &&
        data.adminGoogleEmails is list && data.adminGoogleEmails.size() <= 30 && (data.adminGoogleEmails.size() == 0 || data.adminGoogleEmails[0] is string) &&
        data.registeredOperators is list && data.registeredOperators.size() <= 200 && (data.registeredOperators.size() == 0 || data.registeredOperators[0] is map) &&
        data.registeredManagement is list && data.registeredManagement.size() <= 100 && (data.registeredManagement.size() == 0 || data.registeredManagement[0] is map) &&
        data.theme is string && data.theme.size() >= 1 && data.theme.size() <= 20 &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidWorkspaceMasterData(data) {
      return data.keys().hasAll(['workspaceId', 'ownerUid', 'materials', 'wips', 'skus', 'skuWips', 'wipMats', 'recipes', 'machines', 'tanks', 'productionLines', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly(['workspaceId', 'ownerUid', 'materials', 'wips', 'skus', 'skuWips', 'wipMats', 'recipes', 'machines', 'tanks', 'productionLines', 'updatedAt', 'updatedByUid']) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.materials is list && data.materials.size() <= 1000 && (data.materials.size() == 0 || data.materials[0] is map) &&
        data.wips is list && data.wips.size() <= 500 && (data.wips.size() == 0 || data.wips[0] is map) &&
        data.skus is list && data.skus.size() <= 500 && (data.skus.size() == 0 || data.skus[0] is map) &&
        data.skuWips is list && data.skuWips.size() <= 2000 && (data.skuWips.size() == 0 || data.skuWips[0] is map) &&
        data.wipMats is list && data.wipMats.size() <= 2000 && (data.wipMats.size() == 0 || data.wipMats[0] is map) &&
        data.recipes is list && data.recipes.size() <= 1000 && (data.recipes.size() == 0 || data.recipes[0] is map) &&
        data.machines is list && data.machines.size() <= 300 && (data.machines.size() == 0 || data.machines[0] is map) &&
        data.tanks is list && data.tanks.size() <= 200 && (data.tanks.size() == 0 || data.tanks[0] is map) &&
        data.productionLines is list && data.productionLines.size() <= 100 && (data.productionLines.size() == 0 || data.productionLines[0] is map) &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidWorkspaceOperationsData(data) {
      return data.keys().hasAll(['workspaceId', 'ownerUid', 'activeSkuRuns', 'tank', 'updatedAt', 'updatedByUid']) &&
        data.keys().hasOnly([
          'workspaceId',
          'ownerUid',
          'activeSkuRuns',
          'tank',
          'tanks',
          'lastShiftHandover',
          'weeklyPlannings',
          'activeWeeklyPlanId',
          'activeChangeovers',
          'wipBatches',
          'changeovers',
          'productionStops',
          'transactionsMigratedAt',
          'requests',
          'receipts',
          'usages',
          'cartonProductions',
          'tankLogs',
          'stockAdjustments',
          'updatedAt',
          'updatedByUid'
        ]) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        isValidId(data.ownerUid) &&
        data.activeSkuRuns is list && data.activeSkuRuns.size() <= 100 && (data.activeSkuRuns.size() == 0 || data.activeSkuRuns[0] is map) &&
        data.tank is map &&
        (!('tanks' in data) || (data.tanks is list && data.tanks.size() <= 200 && (data.tanks.size() == 0 || data.tanks[0] is map))) &&
        (!('lastShiftHandover' in data) || data.lastShiftHandover == null || data.lastShiftHandover is map) &&
        (!('weeklyPlannings' in data) || (data.weeklyPlannings is list && data.weeklyPlannings.size() <= 20 && (data.weeklyPlannings.size() == 0 || data.weeklyPlannings[0] is map))) &&
        (!('activeWeeklyPlanId' in data) || data.activeWeeklyPlanId == null || (data.activeWeeklyPlanId is string && data.activeWeeklyPlanId.size() <= 128)) &&
        (!('activeChangeovers' in data) || (data.activeChangeovers is list && data.activeChangeovers.size() <= 300 && (data.activeChangeovers.size() == 0 || data.activeChangeovers[0] is map))) &&
        (!('wipBatches' in data) || (data.wipBatches is list && data.wipBatches.size() <= 1000 && (data.wipBatches.size() == 0 || data.wipBatches[0] is map))) &&
        (!('changeovers' in data) || (data.changeovers is list && data.changeovers.size() <= 500 && (data.changeovers.size() == 0 || data.changeovers[0] is map))) &&
        (!('productionStops' in data) || (data.productionStops is list && data.productionStops.size() <= 1000 && (data.productionStops.size() == 0 || data.productionStops[0] is map))) &&
        (!('transactionsMigratedAt' in data) || data.transactionsMigratedAt == null || data.transactionsMigratedAt is timestamp) &&
        (!('requests' in data) || (data.requests is list && data.requests.size() <= 1000 && (data.requests.size() == 0 || data.requests[0] is map))) &&
        (!('receipts' in data) || (data.receipts is list && data.receipts.size() <= 1000 && (data.receipts.size() == 0 || data.receipts[0] is map))) &&
        (!('usages' in data) || (data.usages is list && data.usages.size() <= 1500 && (data.usages.size() == 0 || data.usages[0] is map))) &&
        (!('cartonProductions' in data) || (data.cartonProductions is list && data.cartonProductions.size() <= 1500 && (data.cartonProductions.size() == 0 || data.cartonProductions[0] is map))) &&
        (!('tankLogs' in data) || (data.tankLogs is list && data.tankLogs.size() <= 1500 && (data.tankLogs.size() == 0 || data.tankLogs[0] is map))) &&
        (!('stockAdjustments' in data) || (data.stockAdjustments is list && data.stockAdjustments.size() <= 500 && (data.stockAdjustments.size() == 0 || data.stockAdjustments[0] is map))) &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidWorkspaceTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'timestamp', 'actorEmail', 'payload', 'shift', 'skuCode']) &&
        data.keys().hasOnly(['id', 'type', 'timestamp', 'actorEmail', 'payload', 'shift', 'skuCode']) &&
        isValidId(data.id) &&
        data.type in ['REQUEST', 'RECEIPT', 'USAGE', 'CARTON_PROD', 'TANK_LOG', 'ADJUSTMENT', 'REJECT_LOG'] &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
        data.actorEmail is string && data.actorEmail.size() >= 1 && data.actorEmail.size() <= 160 &&
        data.payload is map &&
        (data.shift == null || (data.shift is int && data.shift >= 0 && data.shift <= 3)) &&
        data.skuCode is string && data.skuCode.size() <= 128;
    }

    function isValidSblBucket(bucket) {
      return bucket is map &&
        bucket.keys().hasAll(['minutes', 'lossKg']) &&
        bucket.keys().hasOnly(['minutes', 'lossKg']) &&
        bucket.minutes is number && bucket.minutes >= 0 && bucket.minutes <= 1440 &&
        bucket.lossKg is number && bucket.lossKg >= 0 && bucket.lossKg <= 1000000;
    }

    function isValidSixBigLossesBreakdown(bd) {
      return bd is map &&
        bd.keys().hasAll([
          'equipmentFailure',
          'setupAdjustment',
          'idlingMinorStops',
          'reducedSpeed',
          'processDefects',
          'reducedYield'
        ]) &&
        bd.keys().hasOnly([
          'equipmentFailure',
          'setupAdjustment',
          'idlingMinorStops',
          'reducedSpeed',
          'processDefects',
          'reducedYield'
        ]) &&
        isValidSblBucket(bd.equipmentFailure) &&
        isValidSblBucket(bd.setupAdjustment) &&
        isValidSblBucket(bd.idlingMinorStops) &&
        isValidSblBucket(bd.reducedSpeed) &&
        isValidSblBucket(bd.processDefects) &&
        isValidSblBucket(bd.reducedYield);
    }

    function isValidShiftOeeSnapshot(data) {
      return data.keys().hasAll([
          'id',
          'workspaceId',
          'shiftId',
          'lineId',
          'skuCode',
          'availability',
          'performance',
          'quality',
          'oeeScore',
          'sixBigLossesBreakdown',
          'materialVariancePct',
          'updatedAt',
          'updatedByUid'
        ]) &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'shiftId',
          'date',
          'shift',
          'lineId',
          'lineName',
          'skuCode',
          'availability',
          'performance',
          'quality',
          'oeeScore',
          'sixBigLossesBreakdown',
          'materialVariancePct',
          'plannedProductionTimeMinutes',
          'operatingTimeMinutes',
          'totalOutputCartons',
          'goodOutputCartons',
          'standardBomMaterialKg',
          'actualMaterialUsedKg',
          'updatedAt',
          'updatedByUid'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        data.shiftId is string && data.shiftId.size() >= 1 && data.shiftId.size() <= 32 &&
        (!('date' in data) || (data.date is string && data.date.size() == 10)) &&
        (!('shift' in data) || (data.shift is int && data.shift >= 1 && data.shift <= 3)) &&
        isValidId(data.lineId) && data.lineId.size() <= 64 &&
        (!('lineName' in data) || (data.lineName is string && data.lineName.size() <= 120)) &&
        data.skuCode is string && data.skuCode.size() >= 1 && data.skuCode.size() <= 64 &&
        data.availability is number && data.availability >= 0 && data.availability <= 100 &&
        data.performance is number && data.performance >= 0 && data.performance <= 100 &&
        data.quality is number && data.quality >= 0 && data.quality <= 100 &&
        data.oeeScore is number && data.oeeScore >= 0 && data.oeeScore <= 100 &&
        isValidSixBigLossesBreakdown(data.sixBigLossesBreakdown) &&
        data.materialVariancePct is number && data.materialVariancePct >= -100 && data.materialVariancePct <= 10000 &&
        (!('plannedProductionTimeMinutes' in data) || (data.plannedProductionTimeMinutes is number && data.plannedProductionTimeMinutes >= 0 && data.plannedProductionTimeMinutes <= 1440)) &&
        (!('operatingTimeMinutes' in data) || (data.operatingTimeMinutes is number && data.operatingTimeMinutes >= 0 && data.operatingTimeMinutes <= 1440)) &&
        (!('totalOutputCartons' in data) || (data.totalOutputCartons is int && data.totalOutputCartons >= 0 && data.totalOutputCartons <= 10000000)) &&
        (!('goodOutputCartons' in data) || (data.goodOutputCartons is number && data.goodOutputCartons >= 0 && data.goodOutputCartons <= 10000000)) &&
        (!('standardBomMaterialKg' in data) || (data.standardBomMaterialKg is number && data.standardBomMaterialKg >= 0 && data.standardBomMaterialKg <= 10000000)) &&
        (!('actualMaterialUsedKg' in data) || (data.actualMaterialUsedKg is number && data.actualMaterialUsedKg >= 0 && data.actualMaterialUsedKg <= 10000000)) &&
        data.updatedAt is timestamp &&
        isValidId(data.updatedByUid);
    }

    function isValidIiotTelemetryEvent(data) {
      return data.keys().hasAll([
          'id',
          'workspaceId',
          'lineId',
          'status',
          'pulseCount',
          'cycleTimeSec',
          'recordedAt',
          'receivedAt',
          'sourceUid'
        ]) &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'lineId',
          'machineId',
          'skuCode',
          'status',
          'pulseCount',
          'cycleTimeSec',
          'idleMinutes',
          'recordedAt',
          'receivedAt',
          'sourceUid'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        isValidId(data.lineId) && data.lineId.size() <= 64 &&
        (!('machineId' in data) || (data.machineId is string && data.machineId.size() <= 64)) &&
        (!('skuCode' in data) || (data.skuCode is string && data.skuCode.size() <= 64)) &&
        data.status in ['RUNNING', 'STOP', 'IDLE', 'FAULT'] &&
        data.pulseCount is int && data.pulseCount >= 0 && data.pulseCount <= 1000000 &&
        data.cycleTimeSec is number && data.cycleTimeSec >= 0 && data.cycleTimeSec <= 86400 &&
        (!('idleMinutes' in data) || (data.idleMinutes is number && data.idleMinutes >= 0 && data.idleMinutes <= 1440)) &&
        data.recordedAt is string && data.recordedAt.size() >= 1 && data.recordedAt.size() <= 64 &&
        data.receivedAt is timestamp &&
        isValidId(data.sourceUid);
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id',
          'workspaceId',
          'timestamp',
          'createdAt',
          'userId',
          'userName',
          'role',
          'module',
          'action',
          'targetId'
        ]) &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'timestamp',
          'createdAt',
          'userId',
          'userName',
          'userEmail',
          'role',
          'module',
          'action',
          'targetId',
          'targetLabel',
          'previousValueJson',
          'newValueJson',
          'reasonNote'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.workspaceId) && data.workspaceId.size() <= 64 &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64 &&
        data.createdAt is timestamp &&
        isValidId(data.userId) &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160)) &&
        data.role in ['ADMINISTRATOR', 'OFFLINE_PIN_ADMIN', 'SUPERVISOR', 'UNIT_HEAD', 'OPERATOR', 'MANAGEMENT'] &&
        data.module in ['MASTER_BOM', 'STOCK_ADJUSTMENT', 'OEE_DOWNTIME', 'SHIFT_CORRECTION', 'PRODUCTION_USAGE', 'SHIFT_HANDOVER', 'SYSTEM'] &&
        data.action in ['CREATE', 'UPDATE', 'DELETE', 'OVERRIDE'] &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
        (!('targetLabel' in data) || (data.targetLabel is string && data.targetLabel.size() <= 160)) &&
        (!('previousValueJson' in data) || (data.previousValueJson is string && data.previousValueJson.size() <= 4000)) &&
        (!('newValueJson' in data) || (data.newValueJson is string && data.newValueJson.size() <= 4000)) &&
        (!('reasonNote' in data) || (data.reasonNote is string && data.reasonNote.size() <= 500));
    }

    // 4. Connection Health Check (No PII, Read-Only Get)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // 5. System Bootstrap Status (Non-PII, Single-Create Atomic First-Time Setup)
    match /system/bootstrap {
      allow get: if true;
      allow list: if false;
      allow create: if isVerified() &&
        isValidSystemBootstrap(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        incoming().initializedAt == request.time &&
        incoming().updatedAt == request.time &&
        !exists(/databases/$(database)/documents/system/bootstrap) &&
        existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update: if isVerified() &&
        isValidSystemBootstrap(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().initializedAt == existing().initializedAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['factoryName', 'updatedAt']) &&
        (existing().ownerUid == request.auth.uid || isBootstrappedEmailAdmin());
      allow delete: if false;
    }

    // 6. Administrator Profiles (Strict Multi-Tenant PII Isolation)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) &&
        isVerified() &&
        (
          request.auth.uid == adminId ||
          isBootstrappedEmailAdmin() ||
          ('workspaceId' in existing() && isWorkspaceAdmin(existing().workspaceId))
        );
      allow list: if false;
      allow create: if isValidId(adminId) &&
        isVerified() &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == adminId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            adminId == request.auth.uid &&
            incoming().role == 'SUPER_ADMIN' &&
            !exists(/databases/$(database)/documents/system/bootstrap) &&
            existsAfter(/databases/$(database)/documents/system/bootstrap) &&
            getAfter(/databases/$(database)/documents/system/bootstrap).data.ownerUid == request.auth.uid
          ) ||
          (
            adminId == request.auth.uid &&
            incoming().role == 'SUPER_ADMIN' &&
            'workspaceId' in incoming() &&
            incoming().workspaceId == request.auth.uid &&
            !exists(/databases/$(database)/documents/workspaces/$(request.auth.uid)/config/access) &&
            existsAfter(/databases/$(database)/documents/workspaces/$(request.auth.uid)/config/access) &&
            getAfter(/databases/$(database)/documents/workspaces/$(request.auth.uid)/config/access).data.ownerUid == request.auth.uid
          ) ||
          (
            'workspaceId' in incoming() &&
            isWorkspaceAdmin(incoming().workspaceId)
          ) ||
          isBootstrappedEmailAdmin()
        );
      allow update: if isValidId(adminId) &&
        isVerified() &&
        isValidAdminProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            request.auth.uid == adminId &&
            incoming().role == existing().role &&
            (!('workspaceId' in existing()) || incoming().workspaceId == existing().workspaceId) &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'factoryName', 'updatedAt'])
          ) ||
          (
            'workspaceId' in existing() &&
            isWorkspaceAdmin(existing().workspaceId) &&
            incoming().workspaceId == existing().workspaceId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'factoryName', 'role', 'updatedAt'])
          ) ||
          isBootstrappedEmailAdmin()
        );
      allow delete: if isValidId(adminId) &&
        isVerified() &&
        adminId != request.auth.uid &&
        (
          isBootstrappedEmailAdmin() ||
          ('workspaceId' in existing() && isWorkspaceAdmin(existing().workspaceId))
        );
    }

    // 7. Secure Multi-Tenant Email-Hash Workspace Directory (Anti-Enumeration)
    match /workspaceDirectory/{inviteId} {
      allow get: if isValidId(inviteId) &&
        isVerified() &&
        (
          existing().emailLower == userEmailLower() ||
          isWorkspaceAdmin(existing().workspaceId)
        );
      allow list: if false;
      allow create: if isValidId(inviteId) &&
        isVerified() &&
        isValidWorkspaceDirectoryEntry(incoming()) &&
        incoming().inviteId == inviteId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (
          isWorkspaceAdmin(incoming().workspaceId) ||
          (
            incoming().workspaceId == request.auth.uid &&
            incoming().ownerUid == request.auth.uid &&
            existsAfter(/databases/$(database)/documents/workspaces/$(request.auth.uid)/config/access) &&
            getAfter(/databases/$(database)/documents/workspaces/$(request.auth.uid)/config/access).data.ownerUid == request.auth.uid
          )
        );
      allow update: if isValidId(inviteId) &&
        isVerified() &&
        isValidWorkspaceDirectoryEntry(incoming()) &&
        incoming().inviteId == existing().inviteId &&
        incoming().updatedByUid == request.auth.uid &&
        incoming().updatedAt == request.time &&
        isWorkspaceAdmin(existing().workspaceId) &&
        incoming().workspaceId == existing().workspaceId &&
        incoming().ownerUid == existing().ownerUid;
      allow delete: if isValidId(inviteId) &&
        isVerified() &&
        isWorkspaceAdmin(existing().workspaceId);
    }

    // 8. Workspace Configuration & Data (Strict Multi-Tenant Isolation & RBAC)
    match /workspaces/{workspaceId} {
      allow read, write: if false;

      match /config/access {
        allow get: if isValidId(workspaceId) && isWorkspaceAdmin(workspaceId);
        allow list: if false;
        allow create: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceAccessConfig(incoming()) &&
          incoming().workspaceId == workspaceId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (
            (
              hasAccessConfig(workspaceId) &&
              isWorkspaceAdmin(workspaceId) &&
              incoming().ownerUid == accessData(workspaceId).ownerUid
            ) ||
            (
              !hasAccessConfig(workspaceId) &&
              incoming().ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
              (
                workspaceId == request.auth.uid ||
                !exists(/databases/$(database)/documents/system/bootstrap)
              )
            )
          );
        allow update: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceAccessConfig(incoming()) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['adminEmails', 'operatorEmails', 'managementEmails', 'updatedAt', 'updatedByUid']) &&
          isWorkspaceAdmin(workspaceId);
        allow delete: if false;
      }

      match /config/secrets {
        allow get: if isValidId(workspaceId) && isWorkspaceAdmin(workspaceId);
        allow list: if false;
        allow create: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceSecrets(incoming()) &&
          incoming().workspaceId == workspaceId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (
            (
              hasAccessConfig(workspaceId) &&
              isWorkspaceAdmin(workspaceId) &&
              incoming().ownerUid == accessData(workspaceId).ownerUid
            ) ||
            (
              !hasAccessConfig(workspaceId) &&
              incoming().ownerUid == request.auth.uid &&
              existsAfter(accessConfigPath(workspaceId)) &&
              getAfter(accessConfigPath(workspaceId)).data.ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
            )
          );
        allow update: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceSecrets(incoming()) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['adminPin', 'updatedAt', 'updatedByUid']) &&
          isWorkspaceAdmin(workspaceId);
        allow delete: if false;
      }

      match /config/meta {
        allow get: if isValidId(workspaceId) && isWorkspaceAuthorized(workspaceId);
        allow list: if false;
        allow create: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceMeta(incoming()) &&
          incoming().workspaceId == workspaceId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (
            (
              hasAccessConfig(workspaceId) &&
              isWorkspaceAdmin(workspaceId) &&
              incoming().ownerUid == accessData(workspaceId).ownerUid
            ) ||
            (
              !hasAccessConfig(workspaceId) &&
              incoming().ownerUid == request.auth.uid &&
              existsAfter(accessConfigPath(workspaceId)) &&
              getAfter(accessConfigPath(workspaceId)).data.ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
            )
          );
        allow update: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceMeta(incoming()) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          isWorkspaceAdmin(workspaceId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['factoryName', 'adminGoogleEmails', 'registeredOperators', 'registeredManagement', 'theme', 'updatedAt', 'updatedByUid']);
        allow delete: if false;
      }

      match /data/master {
        allow get: if isValidId(workspaceId) && isWorkspaceAuthorized(workspaceId);
        allow list: if false;
        allow create: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceMasterData(incoming()) &&
          incoming().workspaceId == workspaceId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (
            (
              hasAccessConfig(workspaceId) &&
              isWorkspaceAdmin(workspaceId) &&
              incoming().ownerUid == accessData(workspaceId).ownerUid
            ) ||
            (
              !hasAccessConfig(workspaceId) &&
              incoming().ownerUid == request.auth.uid &&
              existsAfter(accessConfigPath(workspaceId)) &&
              getAfter(accessConfigPath(workspaceId)).data.ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
            )
          );
        allow update: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceMasterData(incoming()) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['materials', 'wips', 'skus', 'skuWips', 'wipMats', 'recipes', 'machines', 'tanks', 'productionLines', 'updatedAt', 'updatedByUid']) &&
          isWorkspaceAdmin(workspaceId);
        allow delete: if false;
      }

      match /data/operations {
        allow get: if isValidId(workspaceId) && isWorkspaceAuthorized(workspaceId);
        allow list: if false;
        allow create: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceOperationsData(incoming()) &&
          incoming().workspaceId == workspaceId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (
            (
              hasAccessConfig(workspaceId) &&
              isWorkspaceAdmin(workspaceId) &&
              incoming().ownerUid == accessData(workspaceId).ownerUid
            ) ||
            (
              !hasAccessConfig(workspaceId) &&
              incoming().ownerUid == request.auth.uid &&
              existsAfter(accessConfigPath(workspaceId)) &&
              getAfter(accessConfigPath(workspaceId)).data.ownerUid == request.auth.uid &&
              existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
            )
          );
        allow update: if isValidId(workspaceId) &&
          isVerified() &&
          isValidWorkspaceOperationsData(incoming()) &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'activeSkuRuns',
            'tank',
            'tanks',
            'lastShiftHandover',
            'weeklyPlannings',
            'activeWeeklyPlanId',
            'activeChangeovers',
            'wipBatches',
            'changeovers',
            'productionStops',
            'transactionsMigratedAt',
            'requests',
            'receipts',
            'usages',
            'cartonProductions',
            'tankLogs',
            'stockAdjustments',
            'updatedAt',
            'updatedByUid'
          ]) &&
          (isWorkspaceAdmin(workspaceId) || isWorkspaceOperator(workspaceId));
        allow delete: if false;
      }

      // 9. Individual Transaction Sub-Collection (Scales past 1MB limit & avoids write contention)
      match /transactions/{txId} {
        allow get: if isValidId(workspaceId) && isValidId(txId) && isWorkspaceAuthorized(workspaceId);
        allow list: if isValidId(workspaceId) &&
          isWorkspaceAuthorized(workspaceId) &&
          request.query.limit <= 500;
        allow create: if isValidId(workspaceId) &&
          isValidId(txId) &&
          isVerified() &&
          isValidWorkspaceTransaction(incoming()) &&
          incoming().id == txId &&
          (
            isWorkspaceAdmin(workspaceId) ||
            (isWorkspaceOperator(workspaceId) && incoming().actorEmail.lower() == userEmailLower())
          );
        allow update: if isValidId(workspaceId) &&
          isValidId(txId) &&
          isVerified() &&
          isValidWorkspaceTransaction(incoming()) &&
          incoming().id == existing().id &&
          incoming().type == existing().type &&
          incoming().diff(existing()).affectedKeys().hasOnly(['timestamp', 'actorEmail', 'payload', 'shift', 'skuCode']) &&
          isWorkspaceAdmin(workspaceId);
        allow delete: if isValidId(workspaceId) &&
          isValidId(txId) &&
          isWorkspaceAdmin(workspaceId);
      }

      // 10. Shift OEE Snapshots Sub-Collection (Industry 4.0 Shift & Line OEE Aggregates)
      match /shift_oee_snapshots/{snapshotId} {
        allow get: if isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          isWorkspaceAuthorized(workspaceId);
        allow list: if isValidId(workspaceId) &&
          isWorkspaceAuthorized(workspaceId) &&
          request.query.limit <= 200;
        allow create: if isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          isVerified() &&
          isValidShiftOeeSnapshot(incoming()) &&
          incoming().id == snapshotId &&
          incoming().workspaceId == workspaceId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          (isWorkspaceAdmin(workspaceId) || isWorkspaceOperator(workspaceId));
        allow update: if isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          isVerified() &&
          isValidShiftOeeSnapshot(incoming()) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().shiftId == existing().shiftId &&
          incoming().lineId == existing().lineId &&
          incoming().updatedByUid == request.auth.uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'lineName',
            'date',
            'shift',
            'skuCode',
            'availability',
            'performance',
            'quality',
            'oeeScore',
            'sixBigLossesBreakdown',
            'materialVariancePct',
            'plannedProductionTimeMinutes',
            'operatingTimeMinutes',
            'totalOutputCartons',
            'goodOutputCartons',
            'standardBomMaterialKg',
            'actualMaterialUsedKg',
            'updatedAt',
            'updatedByUid'
          ]) &&
          (isWorkspaceAdmin(workspaceId) || isWorkspaceOperator(workspaceId));
        allow delete: if isValidId(workspaceId) &&
          isValidId(snapshotId) &&
          isWorkspaceAdmin(workspaceId);
      }

      // 11. IIoT Telemetry Stream Sub-Collection (Immutable Machine Output Pulse & Status)
      match /iiot_telemetry/{telemetryId} {
        allow get: if isValidId(workspaceId) &&
          isValidId(telemetryId) &&
          isWorkspaceAuthorized(workspaceId);
        allow list: if isValidId(workspaceId) &&
          isWorkspaceAuthorized(workspaceId) &&
          request.query.limit <= 500;
        allow create: if isValidId(workspaceId) &&
          isValidId(telemetryId) &&
          isVerified() &&
          isValidIiotTelemetryEvent(incoming()) &&
          incoming().id == telemetryId &&
          incoming().workspaceId == workspaceId &&
          incoming().sourceUid == request.auth.uid &&
          incoming().receivedAt == request.time &&
          (isWorkspaceAdmin(workspaceId) || isWorkspaceOperator(workspaceId));
        allow update: if false;
        allow delete: if isValidId(workspaceId) &&
          isValidId(telemetryId) &&
          isWorkspaceAdmin(workspaceId);
      }

      // 12. Immutable Audit Trail Sub-Collection (Strict Admin PII Isolation & Mandatory Override Reason)
      match /audit_logs/{auditId} {
        allow get: if isValidId(workspaceId) &&
          isValidId(auditId) &&
          isWorkspaceAdmin(workspaceId);
        allow list: if isValidId(workspaceId) &&
          isWorkspaceAdmin(workspaceId) &&
          request.query.limit <= 300;
        allow create: if isValidId(workspaceId) &&
          isValidId(auditId) &&
          isVerified() &&
          isValidAuditLog(incoming()) &&
          incoming().id == auditId &&
          incoming().workspaceId == workspaceId &&
          incoming().userId == request.auth.uid &&
          incoming().createdAt == request.time &&
          (isWorkspaceAdmin(workspaceId) || isWorkspaceOperator(workspaceId)) &&
          (!(incoming().module in ['MASTER_BOM', 'STOCK_ADJUSTMENT', 'SHIFT_CORRECTION']) || isWorkspaceAdmin(workspaceId)) &&
          (!(incoming().action in ['DELETE', 'OVERRIDE']) || isWorkspaceAdmin(workspaceId)) &&
          (!(incoming().module == 'SHIFT_CORRECTION' || incoming().action in ['DELETE', 'OVERRIDE']) || ('reasonNote' in incoming() && incoming().reasonNote.size() >= 3));
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
